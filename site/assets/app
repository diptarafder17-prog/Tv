// app.js - small helper for the landing page
(function(){
  const target = 'https://toffeelive.com/en/watch/sy5m-JQBv9knK3AHYTTk';
  let seconds = 5;
  const el = document.getElementById('count');
  if (!el) return;
  const timer = setInterval(()=> {
    seconds--;
    el.textContent = seconds;
    if(seconds<=0){
      clearInterval(timer);
      window.location.replace(target);
    }
  },1000);

  const openBtn = document.getElementById('openBtn');
  if(openBtn){
    openBtn.addEventListener('keydown', e=>{
      if(e.key === 'Enter') window.location.href = target;
    });
  }
})();
